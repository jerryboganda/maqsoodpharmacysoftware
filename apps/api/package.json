{
  "name": "@pharmacy/api",
  "private": true,
  "version": "0.0.1",
  "description": "The modular monolith -- NestJS 11 on the Fastify adapter. docs/system-analysis/17-technical-blueprint.md Part 3-4.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import ./scripts/register-loader.mjs src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env --import ./scripts/register-loader.mjs src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-fastify": "^11.0.10",
    "@pharmacy/config": "workspace:*",
    "@pharmacy/db": "workspace:*",
    "@pharmacy/money": "workspace:*",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.10.0",
    "nestjs-zod": "^4.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.47",
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.10",
    "vitest": "^2.1.9"
  }
}
