{
  "extends": "@pharmacy/config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    // Override the shared NodeNext setting (@pharmacy/config/tsconfig.base.json) for this package
    // only. drizzle-kit's schema loader (checked empirically: it registers a require() hook that
    // transpiles .ts on the fly) resolves extensionless relative specifiers to their sibling .ts
    // file, but fails on an explicit `./tenant.js` specifier -- Node's CJS resolver takes an
    // explicit extension literally and never reaches the .ts fallback, so `require('./tenant.js')`
    // throws MODULE_NOT_FOUND. NodeNext mandates explicit `.js` extensions on relative ESM
    // imports, which is exactly what breaks the loader. Bundler resolution allows (and this
    // package's schema/*.ts files use) extensionless relative imports instead, which satisfies
    // both `tsc --noEmit` and `drizzle-kit generate`. Other packages never see this convention:
    // `main`/`types` point at the tsup-bundled `dist/`, which is NodeNext-clean (see index.ts).
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // tsup's isolated-declaration dts build (`pnpm run build`) doesn't pass a tsBuildInfoFile for
    // this entry, which conflicts with the base config's composite/incremental project-references
    // settings (TS5074). This package isn't referenced via TS project references, so both are safe
    // to disable here.
    "composite": false,
    "incremental": false
  },
  "include": ["schema/**/*.ts", "drizzle.config.ts", "index.ts", "client.ts", "scripts/**/*.ts"]
}
