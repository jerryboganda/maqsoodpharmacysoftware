{
  "extends": "@pharmacy/config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    // Override the shared NodeNext setting (@pharmacy/config/tsconfig.base.json) for this package
    // only. drizzle-kit's schema loader (checked empirically: it registers a require() hook that
    // transpiles .ts on the fly) resolves extensionless relative specifiers to their sibling .ts
    // file, but fails on an explicit `./tenant.js` specifier -- Node's CJS resolver takes an
    // explicit extension literally and never reaches the .ts fallback, so `require('./tenant.js')`
    // throws MODULE_NOT_FOUND (there is no compiled tenant.js on disk; this package ships TS
    // source directly, per its `main`/`types` fields). NodeNext mandates explicit `.js` extensions
    // on relative ESM imports, which is exactly what breaks the loader. Bundler resolution allows
    // (and this package's schema/*.ts files use) extensionless relative imports instead, which
    // satisfies both `tsc --noEmit` and `drizzle-kit generate`.
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["schema/**/*.ts", "drizzle.config.ts"]
}
