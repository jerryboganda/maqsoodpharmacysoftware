DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pharmacy_platform

# API server port. Default (see apps/api/src/main.ts) is 3001, not the more common 3000 --
# 3000 collides with an unrelated project on the original dev machine. Override here if 3001
# is ever unavailable on yours.
PORT=3001
